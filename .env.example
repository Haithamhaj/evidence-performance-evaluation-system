# Local development only. These values are intentionally non-secret and must not be reused elsewhere.
POSTGRES_SUPERUSER_PASSWORD=local-postgres-password
APP_DB_NAME=evaluation
APP_DB_USERNAME=evaluation_app
APP_DB_PASSWORD=local-evaluation-password
TEST_DB_NAME=evaluation_test
TEST_DB_USERNAME=evaluation_test
TEST_DB_PASSWORD=local-evaluation-test-password
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-password
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-password
MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=local-minio-password

DATABASE_URL=postgresql://evaluation_app:local-evaluation-password@127.0.0.1:5432/evaluation
TEST_DATABASE_URL=postgresql://evaluation_test:local-evaluation-test-password@127.0.0.1:5432/evaluation_test
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
OIDC_ISSUER=http://127.0.0.1:8081/realms/evaluation
OIDC_AUDIENCE=evaluation-api
OIDC_CLIENT_ID=evaluation-web
PILOT_MANAGER_OIDC_SUBJECT=pilot-manager
PILOT_ADMIN_OIDC_SUBJECT=system-admin
APP_ENV=local
APP_BASE_URL=http://localhost:3000
OIDC_SESSION_SECRET=local-only-oidc-session-secret-change-outside-local
