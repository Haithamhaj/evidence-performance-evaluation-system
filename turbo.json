{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "APP_ENV",
        "APP_BASE_URL",
        "OIDC_ISSUER",
        "OIDC_AUDIENCE",
        "OIDC_CLIENT_ID",
        "OIDC_SESSION_SECRET",
        "INTERNAL_API_BASE_URL"
      ]
    },
    "@evaluation/api#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "APP_ENV",
        "API_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "DOCUMENT_STORAGE_BUCKET",
        "DOCUMENT_MAX_TEXT_BYTES",
        "DOCUMENT_MAX_OFFICE_BYTES",
        "DOCUMENT_MAX_IMAGE_BYTES",
        "DOCUMENT_MAX_AUDIO_BYTES",
        "DOCUMENT_MAX_ARCHIVE_ENTRIES",
        "DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES",
        "DOCUMENT_MAX_ARCHIVE_COMPRESSION_RATIO",
        "DOCUMENT_SIGNED_URL_TTL_SECONDS",
        "CLAMAV_HOST",
        "CLAMAV_PORT",
        "CLAMAV_TIMEOUT_MILLISECONDS",
        "OIDC_ISSUER",
        "OIDC_AUDIENCE",
        "PILOT_MANAGER_OIDC_SUBJECT",
        "PILOT_ADMIN_OIDC_SUBJECT",
        "GITHUB_WEBHOOK_SECRET",
        "CONNECTED_WORK_CONTEXT_MODE",
        "CONNECTED_WORK_CONTEXT_REDIRECT_URIS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_OAUTH_REDIRECT_URI",
        "GOOGLE_OAUTH_SCOPES",
        "ANALYSIS_OUTBOX_RECONCILE_MS",
        "RESEARCH_SOURCE_TIMEOUT_MS",
        "RESEARCH_SOURCE_MAX_BYTES",
        "RESEARCH_SOURCE_MAX_TEXT_CHARS",
        "RESEARCH_SOURCE_MAX_REDIRECTS",
        "RESEARCH_SOURCE_ALLOWED_MIME_TYPES",
        "OPENAI_API_KEY"
      ]
    },
    "@evaluation/worker#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "OPENAI_API_KEY",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "DOCUMENT_STORAGE_BUCKET",
        "DOCUMENT_MAX_TEXT_BYTES",
        "DOCUMENT_MAX_OFFICE_BYTES",
        "DOCUMENT_MAX_IMAGE_BYTES",
        "DOCUMENT_MAX_AUDIO_BYTES",
        "DOCUMENT_MAX_ARCHIVE_ENTRIES",
        "DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES",
        "DOCUMENT_MAX_ARCHIVE_COMPRESSION_RATIO",
        "DOCUMENT_SIGNED_URL_TTL_SECONDS",
        "WORKER_JOB_TYPE",
        "WORKER_JOB_VERSION",
        "WORKER_HEALTH_HOST",
        "WORKER_HEALTH_PORT",
        "SYSTEM_ID",
        "ANALYSIS_HEARTBEAT_MS",
        "ANALYSIS_LEASE_MS",
        "ANALYSIS_MAX_ATTEMPTS",
        "ANALYSIS_ROUTER_TIMEOUT_MS",
        "RESEARCH_SOURCE_TIMEOUT_MS",
        "RESEARCH_SOURCE_MAX_BYTES",
        "RESEARCH_SOURCE_MAX_TEXT_CHARS",
        "RESEARCH_SOURCE_MAX_REDIRECTS",
        "RESEARCH_SOURCE_ALLOWED_MIME_TYPES"
      ]
    },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
