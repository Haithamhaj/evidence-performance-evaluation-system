let method = "generate";
const opaque = {} as Record<string, () => unknown>;
const reflectedApply = Reflect.apply.bind(Reflect);

class BaseRunner {
  execute() {
    return this.helper();
  }
  helper() {
    return Promise.resolve();
  }
}
class DerivedRunner extends BaseRunner {
  helper() {
    return opaque[method]();
  }
}

reflectedApply(BaseRunner.prototype.execute, new DerivedRunner(), []);
method = "health";
