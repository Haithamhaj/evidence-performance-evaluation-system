let providerPackage = "openai";

class BaseRunner {
  static execute() {
    return this.helper();
  }

  static helper() {
    return Promise.resolve();
  }
}

class DerivedRunner extends BaseRunner {
  static helper() {
    return import(providerPackage);
  }
}

BaseRunner.execute.call(DerivedRunner);
providerPackage = "./safe-local-module";
