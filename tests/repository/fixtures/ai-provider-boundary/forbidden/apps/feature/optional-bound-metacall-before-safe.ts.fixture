let providerBaseUrl = process.env.OPENAI_BASE_URL;

class BaseRunner {
  execute() {
    return this.helper();
  }
  helper() {
    return Promise.resolve();
  }
}
class DerivedRunner extends BaseRunner {
  helper() {
    return fetch(providerBaseUrl);
  }
}

const invoke = Function.prototype.call.bind(BaseRunner.prototype.execute, new DerivedRunner());
invoke?.();
providerBaseUrl = "https://example.test/health";
