let providerBaseUrl = process.env.OPENAI_BASE_URL;

class BaseRunner {
  execute() {
    const nested = () => this.helper();
    return nested();
  }

  helper() {
    return Promise.resolve();
  }
}

class MiddleRunner extends BaseRunner {}
class DerivedRunner extends MiddleRunner {
  helper() {
    return fetch(providerBaseUrl);
  }
}

BaseRunner.prototype.execute.call(new DerivedRunner());
providerBaseUrl = "https://example.test/health";
