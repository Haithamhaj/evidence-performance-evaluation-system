let method = "generate";
const opaque = {} as Record<string, () => unknown>;
const { call: invoke } = Function.prototype;

class BaseRunner {
  execute() {
    return this.helper();
  }
  helper() {
    return Promise.resolve();
  }
}
class DerivedRunner extends BaseRunner {
  helper() {
    return opaque[method]();
  }
}

invoke.call(BaseRunner.prototype.execute, new DerivedRunner());
method = "health";
