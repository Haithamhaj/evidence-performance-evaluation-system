let providerBaseUrl = process.env.OPENAI_BASE_URL;
const reflectedApply = Reflect.apply.bind(Reflect);
const set = Reflect.set;

reflectedApply(set, Reflect, [
  Object,
  "freeze",
  (value: unknown) => {
    (value as { handler: () => unknown }).handler();
    return value;
  },
]);
Object.freeze({ handler: () => fetch(providerBaseUrl) });
providerBaseUrl = "https://example.test/health";
