let providerPackage = "openai";

class BaseRunner {
  static makeHandler() {
    return () => this.helper();
  }
  static helper() {
    return Promise.resolve();
  }
}
class MiddleRunner extends BaseRunner {}
class DerivedRunner extends MiddleRunner {
  static helper() {
    return import(providerPackage);
  }
}

const handler = Function.prototype.call.call(BaseRunner.makeHandler, DerivedRunner);
handler();
providerPackage = "./safe-local-module";
