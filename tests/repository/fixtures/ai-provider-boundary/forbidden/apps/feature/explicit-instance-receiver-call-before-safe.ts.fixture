let method = "generate";
const opaque = {} as Record<string, () => unknown>;

class BaseRunner {
  execute() {
    return this.helper();
  }

  helper() {
    return Promise.resolve();
  }
}

class DerivedRunner extends BaseRunner {
  helper() {
    return opaque[method]();
  }
}

BaseRunner.prototype.execute.call(new DerivedRunner());
method = "health";
