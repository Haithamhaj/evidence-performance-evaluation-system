let providerPackage = "openai";

class BaseRunner {
  execute() {
    const nested = () => this.helper();
    return nested();
  }

  helper() {
    return Promise.resolve();
  }
}

class SafeRunner extends BaseRunner {}
class ProviderRunner extends BaseRunner {
  helper() {
    return import(providerPackage);
  }
}

BaseRunner.prototype.execute.call(new SafeRunner());
providerPackage = "./safe-local-module";
BaseRunner.prototype.execute.call(new ProviderRunner());
