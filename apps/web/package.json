{
  "name": "@evaluation/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node ../../scripts/prepare-next-generated-types.mjs . && next build --experimental-build-mode compile && tsc -p tsconfig.json --noEmit && next build --experimental-build-mode generate",
    "build:storybook": "storybook build --output-dir storybook-static",
    "start": "next start",
    "storybook": "storybook dev --port 6006",
    "lint": "eslint src",
    "typecheck": "node ../../scripts/prepare-next-generated-types.mjs . && next build --experimental-build-mode compile && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. apps/web/src"
  },
  "dependencies": {
    "@evaluation/administration": "workspace:*",
    "@evaluation/continuity": "workspace:*",
    "@evaluation/contracts": "workspace:*",
    "@evaluation/employee-evaluation": "workspace:*",
    "@evaluation/localization": "workspace:*",
    "@evaluation/manager-evaluation": "workspace:*",
    "@evaluation/notifications": "workspace:*",
    "@evaluation/observability": "workspace:*",
    "@evaluation/reporting": "workspace:*",
    "@evaluation/research-experiments": "workspace:*",
    "@evaluation/ui": "workspace:*",
    "jose": "6.2.3",
    "next": "16.2.10",
    "openid-client": "6.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/nextjs-vite": "10.5.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.11.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "storybook": "10.5.7",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
