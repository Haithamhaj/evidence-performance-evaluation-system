{
  "name": "evidence-performance-evaluation-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "infra:down": "docker compose --env-file .env.local -f infra/docker/compose.yml down",
    "infra:reset": "node scripts/reset-local-infra.mjs",
    "infra:up": "docker compose --env-file .env.local -f infra/docker/compose.yml up -d --wait",
    "infra:verify": "node scripts/verify-infra.mjs",
    "lint": "turbo run lint && eslint scripts tests && node scripts/validate-boundaries.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test tests/e2e",
    "test:ai": "vitest run --project ai-evals",
    "validate:task-graph": "python3 scripts/validate_task_graph.py",
    "verify": "pnpm validate:task-graph && pnpm scan:secrets && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1087.0",
    "@aws-sdk/s3-request-presigner": "3.1087.0",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-decorators": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
