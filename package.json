{
  "name": "evidence-performance-evaluation-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.0"
  },
  "dependencies": {
    "@evaluation/ai-routing": "workspace:*",
    "@evaluation/audit": "workspace:*",
    "@evaluation/contracts": "workspace:*",
    "@evaluation/connected-work-context": "workspace:*",
    "@evaluation/coaching-development": "workspace:*",
    "@evaluation/continuity": "workspace:*",
    "@evaluation/database": "workspace:*",
    "@evaluation/documents": "workspace:*",
    "@evaluation/employee-evaluation": "workspace:*",
    "@evaluation/localization": "workspace:*",
    "@evaluation/manager-evaluation": "workspace:*",
    "@evaluation/projects": "workspace:*",
    "@evaluation/research-experiments": "workspace:*",
    "@evaluation/updates-evidence": "workspace:*",
    "@evaluation/work-items": "workspace:*"
  },
  "scripts": {
    "dev": "node scripts/run-local-development.mjs",
    "build": "turbo run build",
    "db:deploy": "pnpm --filter @evaluation/database db:deploy",
    "db:generate": "pnpm --filter @evaluation/database db:generate",
    "db:migrate": "pnpm --filter @evaluation/database db:migrate",
    "db:reset:local": "node scripts/assert-local-database.mjs && pnpm --filter @evaluation/database exec prisma migrate reset --force",
    "db:seed": "pnpm --filter @evaluation/database db:seed",
    "db:verify": "node --env-file=.env.example scripts/verify-migrations.mjs",
    "ai:register:project-progress-contract": "tsx scripts/seed-codex-dogfood.ts --register-route",
    "ai:register:coaching-insight": "tsx scripts/register-coaching-insight-ai-route.ts",
    "ai:register:research-experiments": "tsx scripts/register-research-experiments-ai-routes.ts",
    "ai:register:update-transcribe": "tsx scripts/register-update-transcribe-ai-route.ts",
    "dogfood:seed": "tsx scripts/seed-codex-dogfood.ts --seed",
    "dogfood:draft-contract": "tsx scripts/seed-codex-dogfood.ts --draft-contract",
    "format:check": "prettier --check package.json pnpm-workspace.yaml turbo.json tsconfig.base.json eslint.config.mjs prettier.config.mjs vitest.config.ts vitest.workspace.ts .github apps packages scripts tests",
    "infra:down": "node scripts/run-compose.mjs down",
    "infra:reset": "node scripts/reset-local-infra.mjs",
    "infra:up": "node scripts/run-compose.mjs up -d --wait",
    "infra:verify": "node scripts/verify-infra.mjs",
    "research:seed": "node --env-file=.env.example --import tsx scripts/seed-research-experiments-acceptance.ts",
    "lint": "turbo run lint && eslint scripts tests && node scripts/validate-boundaries.mjs && node scripts/check-user-visible-copy.mjs",
    "scan:performance-inputs": "node scripts/scan-performance-inputs.mjs",
    "scan:ai-boundary": "node scripts/validate-boundaries.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:task-graph && vitest run --project unit",
    "test:coverage": "pnpm test:task-graph && vitest run --project unit --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include='apps/**/src/**/*.{ts,tsx}' --coverage.include='packages/**/src/**/*.ts' --coverage.include='scripts/**/*.mjs'",
    "test:task-graph": "python3 -m unittest scripts.tests.test_validate_task_graph -v",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:ai": "vitest run --project ai-evals",
    "validate:task-graph": "python3 scripts/validate_task_graph.py",
    "verify": "pnpm validate:task-graph && pnpm scan:secrets && pnpm scan:performance-inputs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1087.0",
    "@aws-sdk/s3-request-presigner": "3.1087.0",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-decorators": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "turbo": "2.10.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
