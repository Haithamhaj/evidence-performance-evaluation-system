  manager      User        @relation("ContinuityLeaveDecisionManager", fields: [managerId], references: [id], onDelete: Restrict)
  decision     LeaveState
  reason       String
  auditEventId String      @db.Uuid
  decidedAt    DateTime    @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)

  @@index([leaveId, decidedAt, id])
}

model LeaveTransition {
  id           String      @id @default(uuid()) @db.Uuid
  leaveId      String      @db.Uuid
  leave        LeaveRecord @relation(fields: [leaveId], references: [id], onDelete: Restrict)
