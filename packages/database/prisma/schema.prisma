generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model User {
  id                        String                                 @id @default(uuid()) @db.Uuid
  pilotKey                  String?                                @unique
  email                     String                                 @unique
  displayName               String
  active                    Boolean                                @default(true)
  identities                OidcIdentity[]
  roleAssignments           RoleAssignment[]
  aiRouteConfigs            AiRouteConfig[]
  aiProviderConfigs         AiProviderConfig[]
  aiTrustPolicies           AiLocalTrustPolicy[]
  aiSchemaArtifacts         AiOutputSchemaArtifact[]
  managedEvaluationCycles   EvaluationCycle[]                      @relation("EvaluationCycleManager")
  eligibilityEntries        EligibilityEntry[]                     @relation("EligibilityEmployee")
  createdProjects           Project[]                              @relation("ProjectCreatedBy")
  createdWorkstreams        Workstream[]                           @relation("WorkstreamCreatedBy")
  projectMemberships        ProjectMember[]                        @relation("ProjectMemberEmployee")
  createdProjectMembers     ProjectMember[]                        @relation("ProjectMemberCreatedBy")
  workstreamMemberships     WorkstreamMember[]                     @relation("WorkstreamMemberEmployee")
  createdWorkstreamMembers  WorkstreamMember[]                     @relation("WorkstreamMemberCreatedBy")
  responsibilities          ResponsibilityWindow[]                 @relation("ResponsibilityEmployee")
  responsibilityDecisions   ResponsibilityWindow[]                 @relation("ResponsibilityDecisionBy")
  createdResponsibilities   ResponsibilityWindow[]                 @relation("ResponsibilityCreatedBy")
  projectStatusChanges      ProjectStatusTransition[]              @relation("ProjectStatusActor")
  workstreamStatusChanges   WorkstreamStatusTransition[]           @relation("WorkstreamStatusActor")
  ownershipTransfers        OwnershipTransfer[]                    @relation("OwnershipTransferDecisionBy")
  createdDocumentTemplates  DocumentTemplate[]                     @relation("DocumentTemplateCreatedBy")
  createdTemplateVersions   DocumentTemplateVersion[]              @relation("DocumentTemplateVersionCreatedBy")
  createdUploadedSources    UploadedSource[]                       @relation("UploadedSourceCreatedBy")
  voiceUpdateSessions       VoiceUpdateSession[]                 @relation("VoiceUpdateSessionEmployee")
  voiceTranscriptConfirmations VoiceTranscriptConfirmation[]     @relation("VoiceTranscriptConfirmationEmployee")
  createdDocumentRecords    DocumentRecord[]                       @relation("DocumentRecordCreatedBy")
  createdDocumentVersions   DocumentVersion[]                      @relation("DocumentVersionCreatedBy")
  registeredPromptArtifacts AnalysisPromptArtifact[]               @relation("AnalysisPromptArtifactRegisteredBy")
  createdReadinessChecks    DocumentReadinessCheck[]               @relation("DocumentReadinessCheckCreatedBy")
  readinessTransitions      DocumentReadinessLifecycleTransition[] @relation("ReadinessTransitionActor")
  createdComparisons        DocumentComparison[]                   @relation("DocumentComparisonCreatedBy")
  comparisonReviews         DocumentComparisonReview[]             @relation("DocumentComparisonReviewer")
  createdCriteriaProposals  DynamicCriteriaProposal[]              @relation("DynamicCriteriaProposalCreatedBy")
  criteriaTransitions       DynamicCriteriaProposalTransition[]    @relation("CriteriaProposalTransitionActor")
  ownedCriteriaSnapshots    CriteriaReviewSnapshot[]               @relation("CriteriaReviewSnapshotOwner")
  criteriaEligibility       CriteriaReviewEligibility[]            @relation("CriteriaReviewEligibilityEmployee")
  criteriaResponses         CriteriaContributorResponse[]          @relation("CriteriaContributorResponseEmployee")
  criteriaResolutions       CriteriaManagerResolution[]            @relation("CriteriaManagerResolutionActor")
  criteriaSetTransitions    DynamicCriteriaSetTransition[]         @relation("DynamicCriteriaSetTransitionActor")
  createdWorkItems          WorkItem[]                             @relation("WorkItemCreatedBy")
  assignedWorkItems         WorkItem[]                             @relation("WorkItemAssignee")
  workItemParticipations    WorkItemParticipant[]                  @relation("WorkItemParticipantEmployee")
  workItemParticipationAdds WorkItemParticipant[]                  @relation("WorkItemParticipantCreatedBy")
  workItemStatusChanges     WorkItemStatusHistory[]                @relation("WorkItemStatusActor")
  workItemAssignmentChanges WorkItemAssignmentHistory[]            @relation("WorkItemAssignmentActor")
  workItemAssignmentsFrom   WorkItemAssignmentHistory[]            @relation("WorkItemAssignmentFrom")
  workItemAssignmentsTo     WorkItemAssignmentHistory[]            @relation("WorkItemAssignmentTo")
  privateInboxItems         PrivateInboxItem[]                     @relation("PrivateInboxEmployee")
  connectedWorkAccount      ConnectedWorkAccount?                  @relation("ConnectedWorkAccountEmployee")
  connectedSourceItems      ConnectedSourceItem[]                  @relation("ConnectedSourceItemEmployee")
  connectedSourceExclusions ConnectedSourceExclusion[]             @relation("ConnectedSourceExclusionEmployee")
  connectorSyncCursors      ConnectorSyncCursor[]                  @relation("ConnectorSyncCursorEmployee")
  sourceProjectLinks        SourceProjectLink[]                    @relation("SourceProjectLinkEmployee")
  sourceProjectLinksCreated SourceProjectLink[]                    @relation("SourceProjectLinkLinkedBy")
  sourceProjectLinksRemoved SourceProjectLink[]                    @relation("SourceProjectLinkUnlinkedBy")
  contextAnalyses           ContextAnalysis[]                      @relation("ContextAnalysisEmployee")
  contextAnalysisRevisions  ContextAnalysis[]                      @relation("ContextAnalysisCreatedBy")
  projectLinkSuggestions    ProjectLinkSuggestion[]                @relation("ProjectLinkSuggestionEmployee")
  projectSuggestionRevisions ProjectLinkSuggestion[]               @relation("ProjectLinkSuggestionCreatedBy")
  taskDrafts                TaskDraft[]                            @relation("TaskDraftEmployee")
  taskDraftRevisions        TaskDraft[]                            @relation("TaskDraftCreatedBy")
  proposedTaskAssignments   TaskDraft[]                            @relation("TaskDraftProposedAssignee")
  sourceLinkCorrections     SourceLinkCorrection[]                 @relation("SourceLinkCorrectionEmployee")
  correctedSourceLinks      SourceLinkCorrection[]                 @relation("SourceLinkCorrectionCorrectedBy")
  ownedProgressContracts    ProgressContract[]                     @relation("ProgressContractOwner")
  approvedProgressContracts ProgressContract[]                     @relation("ProgressContractApprover")
  createdProgressContracts  ProgressContract[]                     @relation("ProgressContractCreatedBy")
  progressTransitions       ProgressContractTransition[]           @relation("ProgressContractTransitionActor")
  progressConfirmations     ProgressHumanConfirmation[]            @relation("ProgressHumanConfirmationActor")
  progressSnapshots         ProgressSnapshot[]                     @relation("ProgressSnapshotActor")
  progressContractAiDraftRequests  ProgressContractAiDraftRequest[]  @relation("ProgressContractAiDraftRequestedBy")
  progressContractAiDraftRevisions ProgressContractAiDraftRevision[] @relation("ProgressContractAiDraftRevisionEditor")
  updateSources             UpdateSource[]                         @relation("UpdateSourceEmployee")
  clarificationAnswers      ClarificationAnswer[]                  @relation("ClarificationAnswerEmployee")
  updateDraftRevisions      StructuredUpdateDraftRevision[]        @relation("StructuredUpdateDraftRevisionCreatedBy")
  updateConfirmations       UpdateConfirmation[]                   @relation("UpdateConfirmationEmployee")
  acceptedUpdateEvents      AcceptedUpdateEvent[]                  @relation("AcceptedUpdateEventEmployee")
  evidenceRecords           EvidenceRecord[]                       @relation("EvidenceRecordEmployee")
  evidenceRevisions         EvidenceRevision[]                     @relation("EvidenceRevisionCreatedBy")
  evidenceAttributions      EvidenceAttribution[]                  @relation("EvidenceAttributionEmployee")
  proposedAttributions      EvidenceAttribution[]                  @relation("EvidenceAttributionProposedBy")
  evidenceVerifications     EvidenceVerification[]                 @relation("EvidenceVerificationActor")
  evidenceConfirmations     EvidenceConfirmation[]                 @relation("EvidenceConfirmationEmployee")
  ownedResearchRecords      ResearchRecord[]                       @relation("ResearchRecordOwner")
  authoredResearchRevisions ResearchRevision[]                     @relation("ResearchRevisionAuthor")
  researchParticipantEvents ResearchParticipantEvent[]             @relation("ResearchParticipantEmployee")
  actedResearchParticipantEvents ResearchParticipantEvent[]        @relation("ResearchParticipantActor")
  researchTransitions       ResearchTransition[]                   @relation("ResearchTransitionActor")
  ownedResearchSourceReviews ResearchSourceReview[]                @relation("ResearchSourceReviewOwner")
  authoredResearchSourceReviewRevisions ResearchSourceReviewRevision[] @relation("ResearchSourceReviewRevisionAuthor")
  researchProposalTransitions ResearchProposalTransition[]         @relation("ResearchProposalTransitionActor")
  addedResearchSourceReferences ResearchSourceReference[]          @relation("ResearchSourceReferenceAddedBy")
  authoredExperimentMethods ExperimentMethodRevision[]             @relation("ExperimentMethodRevisionAuthor")
  executedExperimentRuns   ExperimentRun[]                         @relation("ExperimentRunExecutor")
  confirmedExperimentConclusions ExperimentConclusion[]            @relation("ExperimentConclusionConfirmer")
  confirmedResearchConclusions ResearchConclusion[]                @relation("ResearchConclusionConfirmer")
  confirmedAppliedLearning AppliedLearning[]                       @relation("AppliedLearningConfirmer")
  continuityLeaves         LeaveRecord[]                           @relation("ContinuityLeaveEmployee")
  continuityLeaveEligibilityEffects LeaveEligibilityEffect[]       @relation("ContinuityLeaveEligibilityEmployee")
  continuityLeaveDecisions LeaveDecision[]                         @relation("ContinuityLeaveDecisionManager")
  continuityLeaveTransitions LeaveTransition[]                     @relation("ContinuityLeaveTransitionActor")
  continuityHandovers      HandoverRecord[]                        @relation("ContinuityHandoverEmployee")
  continuityHandoverRevisions HandoverRevision[]                   @relation("ContinuityHandoverRevisionAuthor")
  continuityHandoverConfirmations HandoverConfirmation[]           @relation("ContinuityHandoverConfirmationEmployee")
  continuityDelegationsOwned Delegation[]                          @relation("ContinuityDelegationOwner")
  continuityDelegationsReceived Delegation[]                       @relation("ContinuityDelegationDelegate")
  continuityDelegationsManaged Delegation[]                        @relation("ContinuityDelegationManager")
  continuityDelegateConfirmations DelegateConfirmation[]           @relation("ContinuityDelegateConfirmationActor")
  continuityAccessGaps     DelegationAccessGap[]                    @relation("ContinuityAccessGapReporter")
  continuityAccessGapResolutions DelegationAccessGapResolution[]    @relation("ContinuityAccessGapResolutionActor")
  continuityReturnHandoversActing ReturnHandover[]                 @relation("ContinuityReturnActingOwner")
  continuityReturnHandoversOriginal ReturnHandover[]               @relation("ContinuityReturnOriginalOwner")
  continuityReturnConfirmations ReturnHandover[]                   @relation("ContinuityReturnConfirmer")
  continuityReturnFinalizations ReturnHandover[]                   @relation("ContinuityReturnFinalizer")
  continuityReassignmentCases ReassignmentRequiredCase[]          @relation("ContinuityReassignmentFormerOwner")
  continuityReassignmentResolutions ReassignmentResolution[]      @relation("ContinuityReassignmentActor")
  continuityReassignmentSuccessions ReassignmentResolution[]      @relation("ContinuityReassignmentSuccessor")
  continuityDeactivations  DeactivationReceipt[]                   @relation("ContinuityDeactivatedUser")
  continuityDeactivationActors DeactivationReceipt[]               @relation("ContinuityDeactivationAdministrator")
  continuityRetentionReferences RetentionPolicyReference[]         @relation("ContinuityRetentionActor")
  confirmedResearchEvidenceLinks ResearchEvidenceLink[]            @relation("ResearchEvidenceLinkConfirmer")
  createdEvaluationTemplates EvaluationTemplate[] @relation("EvaluationTemplateCreatedBy")
  createdEvaluationTemplateVersions EvaluationTemplateVersion[] @relation("EvaluationTemplateVersionCreatedBy")
  activatedEvaluationTemplateVersions EvaluationTemplateVersion[] @relation("EvaluationTemplateVersionActivatedBy")
  createdEmployeeEvaluationCycles EmployeeEvaluationCycle[] @relation("EmployeeEvaluationCycleCreatedBy")
  employeeEvaluationAssignments EvaluationAssignment[] @relation("EvaluationAssignmentEmployee")
  managedEvaluationAssignments EvaluationAssignment[] @relation("EvaluationAssignmentManager")
  evaluationEligibilityDecisions EvaluationEligibilityDecision[] @relation("EvaluationEligibilityDecisionActor")
  employeeEvaluationCycleTransitions EmployeeEvaluationCycleTransition[] @relation("EmployeeEvaluationCycleTransitionActor")
  createdAssessmentRevisions AssessmentRevision[] @relation("AssessmentRevisionCreatedBy")
  assessmentSubmissions AssessmentSubmission[] @relation("AssessmentSubmissionSubmitter")
  evaluationDiscussionEntries EvaluationDiscussionEntry[] @relation("EvaluationDiscussionEntryActor")
  finalEvaluationDecisions FinalEvaluationDecision[] @relation("FinalEvaluationDecisionManager")
  finalEvaluationSnapshotsAsEmployee FinalEvaluationSnapshot[] @relation("FinalEvaluationSnapshotEmployee")
  finalEvaluationSnapshotsAsManager FinalEvaluationSnapshot[] @relation("FinalEvaluationSnapshotManager")
  evaluationAcknowledgments EvaluationAcknowledgment[] @relation("EvaluationAcknowledgmentActor")
  createdManagerEvaluationTemplates ManagerEvaluationTemplate[] @relation("ManagerEvaluationTemplateCreatedBy")
  createdManagerEvaluationTemplateVersions ManagerEvaluationTemplateVersion[] @relation("ManagerEvaluationTemplateVersionCreatedBy")
  activatedManagerEvaluationTemplateVersions ManagerEvaluationTemplateVersion[] @relation("ManagerEvaluationTemplateVersionActivatedBy")
  createdManagerEvaluationVisibilityPolicies ManagerEvaluationVisibilityPolicy[] @relation("ManagerEvaluationVisibilityPolicyCreatedBy")
  createdManagerEvaluationCycles ManagerEvaluationCycle[] @relation("ManagerEvaluationCycleCreatedBy")
  managedManagerEvaluationCycles ManagerEvaluationCycle[] @relation("ManagerEvaluationCycleManager")
  managerEvaluationCycleSnapshots ManagerEvaluationCycleSnapshot[] @relation("ManagerEvaluationCycleSnapshotManager")
  managerEvaluatorEligibilities ManagerEvaluatorEligibility[] @relation("ManagerEvaluatorEligibilityEvaluator")
  managerEvaluationEligibilityDecisions ManagerEvaluatorEligibilityDecision[] @relation("ManagerEvaluatorEligibilityDecisionActor")
  managerEvaluationCycleTransitions ManagerEvaluationCycleTransition[] @relation("ManagerEvaluationCycleTransitionActor")
  managerEvaluationResponses ManagerEvaluationResponse[] @relation("ManagerEvaluationResponseEvaluator")
  receivedManagerEvaluationResponses ManagerEvaluationResponse[] @relation("ManagerEvaluationResponseManager")
  requestedManagerEvaluationSummaries ManagerEvaluationSummaryRevision[] @relation("ManagerEvaluationSummaryRequestedBy")
  coachingInsightsOwned CoachingInsight[] @relation("CoachingInsightEmployee")
  coachingInsightRevisions CoachingInsightRevision[] @relation("CoachingInsightRevisionAuthor")
  coachingInsightDecisions CoachingInsightDecision[] @relation("CoachingInsightDecisionEmployee")
  formalPlanEvidenceConfirmations FormalDevelopmentPlanEvidenceLink[] @relation("FormalPlanEvidenceConfirmedBy")
  developmentActionsOwned DevelopmentAction[] @relation("DevelopmentActionEmployee")
  developmentActionRevisions DevelopmentActionRevision[] @relation("DevelopmentActionRevisionAuthor")
  developmentActionTransitions DevelopmentActionTransition[] @relation("DevelopmentActionTransitionActor")
  managerSupportEntries ManagerSupportEntry[] @relation("ManagerSupportManager")
  formalPlansOwned FormalDevelopmentPlan[] @relation("FormalPlanEmployee")
  formalPlansManaged FormalDevelopmentPlan[] @relation("FormalPlanManager")
  formalPlanRevisions FormalDevelopmentPlanRevision[] @relation("FormalPlanRevisionAuthor")
  formalPlanAgreements FormalDevelopmentPlanAgreement[] @relation("FormalPlanAgreementActor")
  formalPlanTransitions FormalDevelopmentPlanTransition[] @relation("FormalPlanTransitionActor")
  createdAt                 DateTime                               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                               @updatedAt @db.Timestamptz(6)
}

model OidcIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  issuer    String
  subject   String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([issuer, subject])
  @@index([userId])
}

enum Role {
  employee
  manager
  system_administrator
  project_owner
  workstream_owner
  contributor
  acting_owner
}

enum ScopeType {
  system
  organization
  department
  project
  workstream
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  key               String             @unique
  name              String
  departments       Department[]
  operations        Operation[]
  rubricVersions    RubricVersion[]
  projects          Project[]
  documentTemplates DocumentTemplate[]
  uploadedSources   UploadedSource[]
  documentRecords   DocumentRecord[]
  evaluationTemplates EvaluationTemplate[]
  managerEvaluationTemplates ManagerEvaluationTemplate[]
  managerEvaluationVisibilityPolicies ManagerEvaluationVisibilityPolicy[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
}

enum OperationStatus {
  pending
  running
  succeeded
  failed
}

model Operation {
  id                           String                        @id @db.Uuid
  organizationId               String                        @db.Uuid
  organization                 Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobType                      String
  jobVersion                   Int
  idempotencyKey               String                        @unique
  correlationId                String                        @db.Uuid
  payloadHash                  String
  status                       OperationStatus               @default(pending)
  attemptCount                 Int                           @default(0)
  errorCode                    String?
  resultReference              String?
  startedAt                    DateTime?                     @db.Timestamptz(6)
  completedAt                  DateTime?                     @db.Timestamptz(6)
  createdAt                    DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @db.Timestamptz(6)
  effectReceipts               OperationEffectReceipt[]
  analysisRequest              DocumentAnalysisRequest?
  progressRecalculationRequest ProgressRecalculationRequest?

  @@index([organizationId, status, createdAt])
  @@index([jobType, jobVersion, status, createdAt])
  @@index([status, createdAt])
  @@index([correlationId])
}

model OperationEffectReceipt {
  id               String    @id @default(uuid()) @db.Uuid
  operationId      String    @db.Uuid
  operation        Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  effectName       String
  idempotencyKey   String    @unique
  receiptReference String
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([operationId, effectName])
  @@index([operationId, createdAt])
}

model Department {
  id                  String               @id @default(uuid()) @db.Uuid
  key                 String               @unique
  name                String
  organizationId      String               @db.Uuid
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authorizationScopes AuthorizationScope[]
  evaluationCycles    EvaluationCycle[]
  projects            Project[]
  documentTemplates   DocumentTemplate[]
  uploadedSources     UploadedSource[]
  documentRecords     DocumentRecord[]
  evaluationTemplates EvaluationTemplate[]
  employeeEvaluationCycles EmployeeEvaluationCycle[]
  managerEvaluationTemplates ManagerEvaluationTemplate[]
  managerEvaluationCycles ManagerEvaluationCycle[]
  managerEvaluationCycleSnapshots ManagerEvaluationCycleSnapshot[]
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)

  @@unique([id, organizationId])
  @@index([organizationId])
}

enum FeedbackVisibilityMode {
  identified
  manager_blinded
  anonymous_aggregated
}

enum EligibilityState {
  active
  excluded
  approved_leave
  pending
}

model EvaluationCycle {
  id                 String                 @id @default(uuid()) @db.Uuid
  departmentId       String                 @db.Uuid
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  managerId          String                 @db.Uuid
  manager            User                   @relation("EvaluationCycleManager", fields: [managerId], references: [id], onDelete: Restrict)
  version            Int
  visibilityMode     FeedbackVisibilityMode
  sourceReason       String
  effectiveFrom      DateTime               @db.Timestamptz(6)
  effectiveTo        DateTime               @db.Timestamptz(6)
  openedAt           DateTime?              @db.Timestamptz(6)
  closedAt           DateTime?              @db.Timestamptz(6)
  snapshot           EligibilitySnapshot?
  eligibilityEntries EligibilityEntry[]
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)

  @@unique([departmentId, version])
  @@index([managerId, openedAt])
  @@index([departmentId, openedAt])
}

model EligibilitySnapshot {
  id             String                 @id @default(uuid()) @db.Uuid
  cycleId        String                 @unique @db.Uuid
  cycle          EvaluationCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  version        Int
  visibilityMode FeedbackVisibilityMode
  sourceReason   String
  effectiveFrom  DateTime               @db.Timestamptz(6)
  effectiveTo    DateTime               @db.Timestamptz(6)
  entries        EligibilityEntry[]
  employeeEvaluationCycleSnapshots EmployeeEvaluationCycleSnapshot[]
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)

  @@unique([id, cycleId])
}

model EligibilityEntry {
  id            String              @id @default(uuid()) @db.Uuid
  cycleId       String              @db.Uuid
  cycle         EvaluationCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  snapshotId    String              @db.Uuid
  snapshot      EligibilitySnapshot @relation(fields: [snapshotId, cycleId], references: [id, cycleId], onDelete: Restrict)
  employeeId    String              @db.Uuid
  employee      User                @relation("EligibilityEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  position      Int
  version       Int                 @default(1)
  state         EligibilityState
  sourceReason  String
  effectiveFrom DateTime            @db.Timestamptz(6)
  effectiveTo   DateTime            @db.Timestamptz(6)
  submittedAt   DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([cycleId, employeeId])
  @@unique([snapshotId, position])
  @@index([employeeId, cycleId])
  @@index([cycleId, state])
}

model AuthorizationScope {
  id                    String           @id @default(uuid()) @db.Uuid
  key                   String           @unique
  scopeType             ScopeType
  departmentId          String?          @db.Uuid
  department            Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roleAssignments       RoleAssignment[]
  aiRoutes              AiRoute[]
  aiRunProjectScopes    AiRun[]          @relation("AiRunProjectScope")
  aiRunDepartmentScopes AiRun[]          @relation("AiRunDepartmentScope")
  project               Project?         @relation("ProjectAuthorizationScope")
  workstream            Workstream?      @relation("WorkstreamAuthorizationScope")
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([id, scopeType])
  @@unique([id, scopeType, departmentId])
  @@index([departmentId])
}

enum ProjectStatus {
  draft
  active
  paused
  completed
  archived
}

enum WorkstreamStatus {
  draft
  active
  paused
  completed
  archived
}

enum ResponsibilityType {
  original
  acting
  permanent
  contributor
}

enum OwnershipTransferKind {
  acting
  permanent
}

model Project {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @db.Uuid
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departmentId           String                    @db.Uuid
  department             Department                @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  authorizationScopeId   String                    @unique @db.Uuid
  authorizationScopeType ScopeType                 @default(project)
  authorizationScope     AuthorizationScope        @relation("ProjectAuthorizationScope", fields: [authorizationScopeId, authorizationScopeType, departmentId], references: [id, scopeType, departmentId], onDelete: Restrict)
  name                   String
  description            String
  status                 ProjectStatus             @default(draft)
  version                Int                       @default(1)
  createdById            String                    @db.Uuid
  createdBy              User                      @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workstreams            Workstream[]
  members                ProjectMember[]
  responsibilities       ResponsibilityWindow[]
  ownershipTransfers     OwnershipTransfer[]
  statusTransitions      ProjectStatusTransition[]
  uploadedSources        UploadedSource[]
  documentRecord         DocumentRecord?
  criteriaProposals      DynamicCriteriaProposal[]
  criteriaSets           DynamicCriteriaSet[]
  workItems              WorkItem[]
  privateInboxItems      PrivateInboxItem[]
  sourceProjectLinks     SourceProjectLink[]
  projectLinkSuggestions ProjectLinkSuggestion[] @relation("ProjectLinkSuggestionProject")
  taskDrafts             TaskDraft[] @relation("TaskDraftProject")
  sourceLinkCorrectionsFrom SourceLinkCorrection[] @relation("SourceLinkCorrectionPreviousProject")
  sourceLinkCorrectionsTo SourceLinkCorrection[] @relation("SourceLinkCorrectionCorrectedProject")
  progressContracts      ProgressContract[]
  progressContractAiDraftRequests ProgressContractAiDraftRequest[]
  updateSources          UpdateSource[]
  voiceUpdateSessions    VoiceUpdateSession[]
  evidenceRecords        EvidenceRecord[]
  acceptedUpdateEvents   AcceptedUpdateEvent[]
  acceptedEvidenceEvents AcceptedEvidenceEvent[]
  githubProjectBindings  GitHubProjectBinding[]
  githubProgressReviews  GitHubProgressReview[]
  researchRecords        ResearchRecord[]
  researchSourceReviews  ResearchSourceReview[]
  continuityHandoverItems HandoverItem[]
  continuityDelegationScopes DelegationScope[]
  continuityReassignmentCases ReassignmentRequiredCase[]
  createdAt              DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(6)

  @@unique([authorizationScopeId, authorizationScopeType])
  @@unique([authorizationScopeId, authorizationScopeType, departmentId])
  @@index([organizationId, departmentId, status])
  @@index([departmentId, status, createdAt])
  @@index([createdById, createdAt])
}

model ProjectStatusTransition {
  id               String        @id @default(uuid()) @db.Uuid
  projectId        String        @db.Uuid
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  fromStatus       ProjectStatus
  toStatus         ProjectStatus
  effectiveAt      DateTime      @db.Timestamptz(6)
  actorId          String        @db.Uuid
  actor            User          @relation("ProjectStatusActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason           String
  resultingVersion Int
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([projectId, resultingVersion])
  @@index([projectId, effectiveAt, id])
  @@index([actorId, createdAt])
}

enum GitHubEventVerificationState {
  VERIFIED
  REJECTED
}

model GitHubAppInstallation {
  id              String                 @id @default(uuid()) @db.Uuid
  installationId  String                 @unique
  projectBindings GitHubProjectBinding[]
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)
}

model GitHubProjectBinding {
  id                    String                      @id @default(uuid()) @db.Uuid
  projectId             String                      @db.Uuid
  project               Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  installationId        String                      @db.Uuid
  installation          GitHubAppInstallation       @relation(fields: [installationId], references: [id], onDelete: Restrict)
  repositoryId          String
  boundAt               DateTime                    @db.Timestamptz(6)
  unboundAt             DateTime?                   @db.Timestamptz(6)
  sourceEvents          GitHubSourceEvent[]
  contractRules         GitHubContractRule[]
  progressReviews       GitHubProgressReview[]
  reconciliationCursor  GitHubReconciliationCursor?
  createdAt             DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @db.Timestamptz(6)

  @@unique([id, installationId, repositoryId])
  @@index([projectId, repositoryId, unboundAt, boundAt(sort: Desc)], map: "GitHubProjectBinding_project_repository_active_idx")
  @@index([installationId, repositoryId, unboundAt, boundAt(sort: Desc)], map: "GitHubProjectBinding_installation_repository_active_idx")
}

model GitHubSourceEvent {
  id                String                       @id @default(uuid()) @db.Uuid
  bindingId         String                       @db.Uuid
  installationId    String                       @db.Uuid
  repositoryId      String
  binding           GitHubProjectBinding         @relation(fields: [bindingId, installationId, repositoryId], references: [id, installationId, repositoryId], onDelete: Restrict)
  deliveryId        String                       @unique
  eventType         String
  sourceId          String
  sourceUrl         String
  occurredAt        DateTime                     @db.Timestamptz(6)
  verificationState GitHubEventVerificationState
  governedFacts     Json
  evidenceRecords   EvidenceRecord[]
  progressReviews   GitHubProgressReview[]
  createdAt         DateTime                     @default(now()) @db.Timestamptz(6)

  @@index([bindingId, occurredAt(sort: Desc), id], map: "GitHubSourceEvent_binding_time_idx")
  @@index([installationId, repositoryId, occurredAt(sort: Desc), id], map: "GitHubSourceEvent_repository_time_idx")
  @@index([sourceId, occurredAt(sort: Desc)], map: "GitHubSourceEvent_source_time_idx")
}

enum GitHubGovernedEventKind {
  pull_request
  commit
  check
  deployment
}

enum GitHubGovernedAcceptanceState {
  open
  closed
  merged
  created
  queued
  in_progress
  success
