generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  pilotKey        String?          @unique
  email           String           @unique
  displayName     String
  active          Boolean          @default(true)
  identities      OidcIdentity[]
  roleAssignments RoleAssignment[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
}

model OidcIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  issuer    String
  subject   String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([issuer, subject])
  @@index([userId])
}

enum Role {
  employee
  manager
  system_administrator
  project_owner
  workstream_owner
  contributor
  acting_owner
}

enum ScopeType {
  system
  organization
  department
  project
  workstream
}

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  key            String          @unique
  name           String
  departments    Department[]
  rubricVersions RubricVersion[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
}

model Department {
  id                  String               @id @default(uuid()) @db.Uuid
  key                 String               @unique
  name                String
  organizationId      String               @db.Uuid
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authorizationScopes AuthorizationScope[]
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)

  @@index([organizationId])
}

model AuthorizationScope {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  scopeType       ScopeType
  departmentId    String?          @db.Uuid
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([id, scopeType])
  @@index([departmentId])
}

model RoleAssignment {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role
  scopeType ScopeType
  scopeId   String             @db.Uuid
  scope     AuthorizationScope @relation(fields: [scopeId, scopeType], references: [id, scopeType], onDelete: Restrict)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([userId, role, scopeType, scopeId])
  @@index([userId])
  @@index([scopeType, scopeId])
}

model AuditEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  eventType          String
  actorKind          String
  actorId            String
  effectiveSubjectId String   @db.Uuid
  scopeType          String
  scopeId            String   @db.Uuid
  targetType         String
  targetId           String   @db.Uuid
  reason             String?
  safeDiff           Json?
  correlationId      String   @db.Uuid
  source             String
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([eventType, createdAt, id])
  @@index([actorKind, actorId, createdAt, id])
  @@index([scopeType, scopeId, createdAt, id])
  @@index([targetType, targetId, createdAt, id])
  @@index([correlationId])
  @@index([createdAt, id])
}

enum RubricStatus {
  draft
  active
}

enum RubricCriterionKind {
  employee
  project_contribution
  manager
}

model RubricVersion {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version        String
  status         RubricStatus   @default(draft)
  activatedAt    DateTime?      @db.Timestamptz(6)
  locales        RubricLocale[]
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, version])
  @@index([organizationId, status])
}

model RubricLocale {
  id              String            @id @default(uuid()) @db.Uuid
  rubricVersionId String            @db.Uuid
  rubricVersion   RubricVersion     @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  locale          String
  sourceHash      String
  status          RubricStatus      @default(draft)
  activatedAt     DateTime?         @db.Timestamptz(6)
  biasGuidance    Json
  sections        RubricSection[]
  criteria        RubricCriterion[]
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([rubricVersionId, locale])
  @@index([rubricVersionId, status])
}

model RubricSection {
  id             String            @id @default(uuid()) @db.Uuid
  rubricLocaleId String            @db.Uuid
  rubricLocale   RubricLocale      @relation(fields: [rubricLocaleId], references: [id], onDelete: Restrict)
  stableId       String
  title          String
  weight         Int
  displayOrder   Int
  criteria       RubricCriterion[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([id, rubricLocaleId])
  @@unique([rubricLocaleId, stableId])
  @@unique([rubricLocaleId, displayOrder])
}

model RubricCriterion {
  id              String               @id @default(uuid()) @db.Uuid
  rubricLocaleId  String               @db.Uuid
  rubricLocale    RubricLocale         @relation(fields: [rubricLocaleId], references: [id], onDelete: Restrict)
  sectionId       String?              @db.Uuid
  section         RubricSection?       @relation(fields: [sectionId, rubricLocaleId], references: [id, rubricLocaleId], onDelete: Restrict)
  stableId        String
  kind            RubricCriterionKind
  title           String
  assessmentBasis String?
  internalWeight  Int?
  content         Json
  displayOrder    Int
  anchors         RubricAnchor[]
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)

  @@unique([rubricLocaleId, stableId])
  @@unique([rubricLocaleId, displayOrder])
  @@index([sectionId])
}

model RubricAnchor {
  id          String          @id @default(uuid()) @db.Uuid
  criterionId String          @db.Uuid
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  rating      Int
  text        String
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([criterionId, rating])
}
