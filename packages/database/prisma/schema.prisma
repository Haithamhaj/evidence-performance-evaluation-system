enum ProgressScopeKind {
  project
  workstream
}

enum ProgressContractState {
  draft
  pending_approval
  active
  superseded
  rejected
}

enum ProgressCalculationKind {
  weighted
  stage_gate
}

enum ProgressComponentKind {
  milestone
  deliverable
  kpi
  acceptance
}

enum ProgressDirection {
  increase
  decrease
  maintain
}

enum ProgressConfirmationMode {
  measured
  human_confirmed
  deterministic
}

enum ProgressSourceKind {
  document
  update
  evidence
  kpi_measurement
  human_confirmation
}

enum ProgressContractAiDraftRequestState {
  pending
  ready
  failed
  applied
  rejected
}

enum ProgressContractAiDraftRevisionOrigin {
  ai
  human
}

model ProgressContract {
  id                       String                         @id @default(uuid()) @db.Uuid
  scopeKind                ProgressScopeKind
  projectId                String                         @db.Uuid
  project                  Project                        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workstreamId             String?                        @db.Uuid
  workstream               Workstream?                    @relation(fields: [workstreamId, projectId], references: [id, projectId], onDelete: Restrict)
  sourceDocumentId         String                         @db.Uuid
  sourceDocument           DocumentRecord                 @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  sourceDocumentVersionId  String                         @db.Uuid
  sourceDocumentVersion    DocumentVersion                @relation(fields: [sourceDocumentVersionId, sourceDocumentId], references: [id, documentId], onDelete: Restrict)
  sourceDocumentVersionNo  Int
  calculationKind          ProgressCalculationKind
  calculationSchemaVersion String
  contractVersion          Int
  version                  Int                            @default(1)
  state                    ProgressContractState          @default(draft)
  ownerId                  String                         @db.Uuid
  owner                    User                           @relation("ProgressContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  approverId               String?                        @db.Uuid
  approver                 User?                          @relation("ProgressContractApprover", fields: [approverId], references: [id], onDelete: Restrict)
  effectiveAt              DateTime                       @db.Timestamptz(6)
  approvedAt               DateTime?                      @db.Timestamptz(6)
  previousContractId       String?                        @unique @db.Uuid
  previousContract         ProgressContract?              @relation("ProgressContractSuccessor", fields: [previousContractId], references: [id], onDelete: Restrict)
  successorContract        ProgressContract?              @relation("ProgressContractSuccessor")
  createdById              String                         @db.Uuid
  createdBy                User                           @relation("ProgressContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  components               ProgressContractComponent[]
  transitions              ProgressContractTransition[]
  confirmations            ProgressHumanConfirmation[]
  snapshots                ProgressSnapshot[]
  recalculationRequests    ProgressRecalculationRequest[]
  appliedAiDraftRequest    ProgressContractAiDraftRequest?          @relation("AppliedProgressContractAiDraft")
  createdAt                DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                       @updatedAt @db.Timestamptz(6)

  @@index([projectId, state, effectiveAt])
  @@index([workstreamId, state, effectiveAt])
  @@index([sourceDocumentVersionId])
  @@index([ownerId, state])
}

model ProgressContractAiDraftRequest {
  id                  String                              @id @default(uuid()) @db.Uuid
  projectId           String                              @db.Uuid
  project             Project                             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  documentId          String                              @db.Uuid
  document            DocumentRecord                      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentVersionId   String                              @db.Uuid
  documentVersion     DocumentVersion                     @relation(fields: [documentVersionId, documentId], references: [id, documentId], onDelete: Restrict)
  requestedById       String                              @db.Uuid
  requestedBy         User                                @relation("ProgressContractAiDraftRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  idempotencyKey      String
  payloadHash         String
  state               ProgressContractAiDraftRequestState @default(pending)
  sourceChecksum      String
  routeKey            String
  promptVersion       String
  outputSchemaVersion String
  locale              String
  timezone            String
  effectiveAt         DateTime                            @db.Timestamptz(6)
  aiRunTraceId        String?                             @db.Uuid
  aiRunTrace          AiRun?                              @relation(fields: [aiRunTraceId], references: [id], onDelete: Restrict)
  failureCode         String?
  appliedContractId   String?                             @unique @db.Uuid
  appliedContract     ProgressContract?                   @relation("AppliedProgressContractAiDraft", fields: [appliedContractId], references: [id], onDelete: Restrict)
  revisions           ProgressContractAiDraftRevision[]
  createdAt           DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                            @updatedAt @db.Timestamptz(6)

  @@unique([requestedById, idempotencyKey])
  @@index([projectId, state, createdAt(sort: Desc)])
  @@index([documentVersionId])
  @@index([state, createdAt(sort: Desc)])
  @@index([aiRunTraceId])
}

model ProgressContractAiDraftRevision {
  id               String                                @id @default(uuid()) @db.Uuid
