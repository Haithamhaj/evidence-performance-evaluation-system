enum ContinuityScopeKind {
  PROJECT
  WORKSTREAM
}

enum LeaveState {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ACTIVE
  RETURNED
  CANCELLED
}

enum LeaveReasonCategory {
  PLANNED_LEAVE
  UNPLANNED_LEAVE
  OTHER_APPROVED_ABSENCE
}

enum DelegationState {
  DRAFT
  PENDING_MANAGER
  PENDING_DELEGATE
  ACTIVE
  EXPIRED
  RETURNED
  CANCELLED
}

enum DelegationGapState {
  OPEN
  RESOLVED
}

enum DelegationGapResolutionKind {
  RESOLVED
  EMERGENCY_OVERRIDE
}

enum ReturnHandoverState {
  DRAFT
  OWNER_CONFIRMED
  FINALIZED
}

enum ReturnChoice {
  RETURN
  EXTEND
  PERMANENT_TRANSFER
}

enum ReassignmentCaseState {
  REASSIGNMENT_REQUIRED
  RESOLVED
  CANCELLED
}

enum ReassignmentResolutionKind {
  PERMANENT_REASSIGNMENT
  PAUSE
  CLOSE
  MERGE
}

model LeaveRecord {
  id             String              @id @default(uuid()) @db.Uuid
  employeeId     String              @db.Uuid
  employee       User                @relation("ContinuityLeaveEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  departmentId   String              @db.Uuid
  state          LeaveState          @default(DRAFT)
  startsAt       DateTime            @db.Timestamptz(6)
  endsAt         DateTime            @db.Timestamptz(6)
  reasonCategory LeaveReasonCategory
  affectedScopes Json
  version        Int                 @default(1)
  decisions      LeaveDecision[]
  transitions    LeaveTransition[]
  eligibilityEffect LeaveEligibilityEffect?
  handovers      HandoverRecord[]
  delegations    Delegation[]
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  @@index([employeeId, startsAt, endsAt])
  @@index([departmentId, state, startsAt])
}

model LeaveEligibilityEffect {
  id                            String      @id @default(uuid()) @db.Uuid
  leaveId                       String      @unique @db.Uuid
  leave                         LeaveRecord @relation(fields: [leaveId], references: [id], onDelete: Restrict)
  employeeId                    String      @db.Uuid
  employee                      User        @relation("ContinuityLeaveEligibilityEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  startsAt                      DateTime    @db.Timestamptz(6)
  endsAt                        DateTime    @db.Timestamptz(6)
  checkInRequired               Boolean
  negativeRegularitySignal      Boolean
  evaluationObligationSuspended Boolean
  auditEventId                  String      @db.Uuid
  publishedAt                   DateTime    @db.Timestamptz(6)
  createdAt                     DateTime    @default(now()) @db.Timestamptz(6)

  @@index([employeeId, startsAt, endsAt])
}

model LeaveDecision {
  id           String      @id @default(uuid()) @db.Uuid
  leaveId      String      @db.Uuid
  leave        LeaveRecord @relation(fields: [leaveId], references: [id], onDelete: Restrict)
