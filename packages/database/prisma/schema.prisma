  promptVersion       String?
  routeTrace          Json?
  authorId            String                 @db.Uuid
  author              User                   @relation("ResearchRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now()) @db.Timestamptz(6)

  @@unique([researchId, revision])
  @@index([aiRunId])
  @@index([authorId, createdAt])
}

