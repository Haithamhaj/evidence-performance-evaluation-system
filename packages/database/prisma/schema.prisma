model ResearchRecord {
  id                     String                     @id @default(uuid()) @db.Uuid
  idempotencyKey         String                     @db.Uuid
  projectId              String                     @db.Uuid
  project                Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workstreamId           String?                    @db.Uuid
  workstream             Workstream?                @relation(fields: [workstreamId, projectId], references: [id, projectId], onDelete: Restrict)
  workItemId             String?                    @db.Uuid
  workItem               WorkItem?                  @relation(fields: [workItemId, projectId], references: [id, projectId], onDelete: Restrict)
  ownerId                String                     @db.Uuid
  owner                  User                       @relation("ResearchRecordOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  state                  ResearchState              @default(DRAFT)
  revision               Int                        @default(1)
  version                Int                        @default(1)
  revisions              ResearchRevision[]
  participantEvents      ResearchParticipantEvent[]
  transitions            ResearchTransition[]       @relation("ResearchTransitionRecord")
  successorTransitions   ResearchTransition[]       @relation("ResearchTransitionSuccessor")
  sourceReferences       ResearchSourceReference[]  @relation("ResearchSourceReferenceRecord")
  successorSourceLinks   ResearchSourceReference[]  @relation("ResearchSourceReferenceSuccessorResearch")
  experiments            Experiment[]               @relation("ExperimentResearch")
  researchConclusions    ResearchConclusion[]       @relation("ResearchConclusionRecord")
  appliedLearning        AppliedLearning[]          @relation("AppliedLearningResearch")
  appliedLearningTargets AppliedLearning[]          @relation("AppliedLearningTargetResearch")
  evidenceLinks          ResearchEvidenceLink[]     @relation("ResearchEvidenceLinkResearch")
  createdAt              DateTime                   @default(now()) @db.Timestamptz(6)
  transitionedAt         DateTime                   @default(now()) @db.Timestamptz(6)

  @@unique([ownerId, projectId, idempotencyKey])
  @@index([projectId, state, createdAt])
  @@index([ownerId, state, createdAt])
  @@index([workstreamId, createdAt])
  @@index([workItemId, createdAt])
}

model ResearchRevision {
  id                  String                 @id @default(uuid()) @db.Uuid
  researchId          String                 @db.Uuid
  research            ResearchRecord         @relation(fields: [researchId], references: [id], onDelete: Restrict)
  revision            Int
  origin              ResearchRevisionOrigin
  problemStatement    String
  context             String
  question            String
  objective           String
  hypothesisKind      ResearchHypothesisKind
  hypothesisStatement String?
  noHypothesisReason  String?
  assumptions         Json
  constraints         Json
  knownUncertainty    Json
  alternatives        Json
  decisionQuestion    String
  sourceReferences    Json
  executionMode       Phase2ExecutionMode
  aiRunId             String?                @db.Uuid
